# Chave do Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Modelos em ordem de preferencia (separados por virgula). Se a cota de um acabar, o proximo e usado.
AGENT_MODEL=google/gemini-3.5-flash,google/gemini-3.1-flash-lite,google/gemini-3-flash-preview
# Caminho do banco SQLite
DATABASE_PATH=./data/nexo.db
# Probabilidade (0-1) de o sistema legado de chamados falhar numa chamada. Use 0 para desligar.
LEGACY_FAILURE_RATE=0.15
# Limite de mensagens do funcionario por conversa
MAX_USER_MESSAGES=30
